# Copy to .env and fill in your values.
# Authentik > Directory > Tokens and App passwords > Create
#   Identifier: anything, e.g. "mcp-readonly"
#   User: a dedicated service account (do not reuse your own admin user)
#   Intent: API Token
# Scope the service account's permissions as narrowly as Authentik's RBAC
# allows for what you want this server to do — see README's
# "Why no destructive tools" / permissions section before granting more.
AUTHENTIK_URL=http://192.168.1.50:9000
AUTHENTIK_API_TOKEN=replace-with-your-authentik-api-token

# Interface/port the MCP server listens on inside the container.
MCP_HOST=0.0.0.0
MCP_PORT=8937

# Shared secret required as `Authorization: Bearer <token>` on every request.
# Leave unset to run with no auth (anyone who can reach the port can call
# every tool, including one that can enable/disable user accounts). Generate
# one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
