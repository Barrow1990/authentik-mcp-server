# Copy to .env and fill in your values.
#
# This one file feeds BOTH containers in docker-compose.yml (authentik-mcp-
# read and authentik-mcp-write) — each container's environment: block picks
# out only the variables it needs via ${VAR} substitution, so e.g. the read
# container never actually receives AUTHENTIK_API_TOKEN_WRITE at runtime
# even though it's sitting in this same file. Run `docker compose config`
# after editing this to double-check exactly what each container will get.

# Authentik > Directory > Tokens and App passwords > Create
#   Identifier: anything, e.g. "mcp-readonly" / "mcp-write"
#   User: a dedicated service account per token (do not reuse your own admin
#         user, and do not reuse one service account for both tokens either)
#   Intent: API Token
AUTHENTIK_URL=http://192.168.1.50:9000

# Recommended: two SEPARATE service accounts with different RBAC scopes —
# AUTHENTIK_API_TOKEN_READ needs only view_* permissions (view_user,
# view_group, view_application, view_event, view_system_info);
# AUTHENTIK_API_TOKEN_WRITE additionally needs authentik_core.change_user.
# This way even a full compromise of the read container can't yield a
# credential capable of writing anything — enforced by Authentik's own RBAC,
# not just by this server declining to register the tool.
AUTHENTIK_API_TOKEN_READ=replace-with-a-read-scoped-authentik-api-token
AUTHENTIK_API_TOKEN_WRITE=replace-with-a-write-scoped-authentik-api-token

# Master switch for the one write tool (set_user_active), checked only by
# the write container. Off by default — even with this true, each call
# still needs confirm=True too. See README's "Why no destructive tools"
# section before turning this on.
AUTHENTIK_ALLOW_WRITES=false

# Distinct bearer secrets per container, so a leaked read-side token can't
# be replayed against the write container's port. Given what the write
# container can do, treat MCP_AUTH_TOKEN_WRITE as non-optional — leaving it
# unset runs that container with no auth at all. Generate with:
# openssl rand -hex 32
MCP_AUTH_TOKEN_READ=
MCP_AUTH_TOKEN_WRITE=
